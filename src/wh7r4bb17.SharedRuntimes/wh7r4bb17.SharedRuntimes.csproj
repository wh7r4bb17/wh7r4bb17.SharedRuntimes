<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="Directory.Build.Package.props" Condition="Exists('Directory.Build.Package.props')" />
	<Import Project="Directory.Build.BeforeEnd.targets" Condition="Exists('Directory.Build.BeforeEnd.targets')" />

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectMTBuildTaskPackageFiles</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\buildTasks\wh7r4bb17.SharedRuntimes.Build\wh7r4bb17.SharedRuntimes.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />

		<None Include="../../buildTransitive/*.targets" Pack="true" PackagePath="buildTransitive/" />

		<None Include="../../docs/README.nuget.md" Pack="true" PackagePath="/" />
		<None Include="../../docs/LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
		<None Include="../../docs/NOTICE.txt" Pack="true" PackagePath="NOTICE.txt" />
		
		<None Include="../../tests/**/*" Exclude="../../tests/**/bin/**;../../tests/**/obj/**" LinkBase="Tests" Pack="false" />
	</ItemGroup>

	<Target Name="CollectMTBuildTaskPackageFiles">
		<MSBuild Projects="../../buildTasks/wh7r4bb17.SharedRuntimes.Build/wh7r4bb17.SharedRuntimes.Build.csproj" Targets="Build" Condition="'$(NoBuild)' != 'true'" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PlatformTarget" Properties="Configuration=$(Configuration);GeneratePackageOnBuild=false" />
		<MSBuild Projects="../../buildTasks/wh7r4bb17.SharedRuntimes.Build/wh7r4bb17.SharedRuntimes.Build.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PlatformTarget" Properties="Configuration=$(Configuration);GeneratePackageOnBuild=false">
			<Output TaskParameter="TargetOutputs" ItemName="_MTBuildTaskOutput" />
		</MSBuild>
		<Error Condition="!Exists('%(_MTBuildTaskOutput.Identity)')" Text="Build task output is missing. Build the task project before using --no-build." />
		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_MTBuildTaskOutput)" PackagePath="buildTransitive/tools/" />
		</ItemGroup>
	</Target>

</Project>