<?xml version="1.0" encoding="utf-8"?>
<Project>

	<Target Name="Sign" AfterTargets="PostBuildEvent" Condition=" '$(Configuration)' == 'Release' and '$(DoSigning)' == 'True' and Exists('$(Sign)\SignFiles.exe') ">
		<Exec Command="echo Sign Output File: '$(TargetDir)$(TargetFileName)'..." />
		<Exec Command="&quot;$(Sign)\SignFiles.exe&quot; &quot;$(TargetDir)$(TargetFileName)&quot; $(Cert)" />
		<Exec Command="echo ..." />
	</Target>

</Project>